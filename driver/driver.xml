<devicedata>
  <copyright>Copyright 2026 DirectorLink contributors</copyright>
  <manufacturer>DirectorLink</manufacturer>
  <name>DirectorLink</name>
  <model>DirectorLink</model>
  <creator>DirectorLink contributors</creator>
  <created>09/25/2026 00:00</created>
  <modified>09/27/2026 00:00</modified>
  <!-- scripts/build.py stamps this from the VERSION file (major*10000 + minor*100 + patch). -->
  <version>0</version>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>

  <control>lua_gen</control>
  <controlmethod>other</controlmethod>
  <driver>DriverWorks</driver>
  <minimum_os_version>3.3.0</minimum_os_version>
  <auto_update>false</auto_update>

  <config>
    <documentation file="www/documentation.html"/>
    <script file="driver.lua"></script>
    <actions>
      <action>
        <name>New Pairing Code</name>
        <command>NEW_PAIRING_CODE</command>
      </action>
      <action>
        <name>Revoke All API Keys</name>
        <command>REVOKE_API_KEYS</command>
      </action>
      <action>
        <name>Print Schedules and Scenes</name>
        <command>PRINT_AUTOMATION</command>
      </action>
      <action>
        <name>Refresh Project</name>
        <command>REFRESH_PROJECT</command>
      </action>
      <action>
        <name>Reset Remote Identity</name>
        <command>RESET_REMOTE_IDENTITY</command>
      </action>
      <action>
        <name>Remove All Scene Links</name>
        <command>REMOVE_SCENE_LINKS</command>
      </action>
    </actions>
    <properties>
      <property>
        <name>Status</name>
        <default>Starting...</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Version</name>
        <default></default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>API Status</name>
        <default>Offline</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Pairing Code</name>
        <default></default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Pairing Status</name>
        <default>Starting...</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>API Keys</name>
        <default>0</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Door Control</name>
        <type>LIST</type>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <default>Disabled</default>
      </property>
      <property>
        <name>Relay Hold</name>
        <type>LIST</type>
        <items>
          <item>Not allowed</item>
          <item>Allowed</item>
        </items>
        <default>Not allowed</default>
        <tooltip>Allowed lets API clients hold a relay closed with PATCH state closed, and the app open a Relay Door or Gate Controller set to Hold; scenes always pulse. Leave Not allowed for doors and gates: a held contact keeps them open.</tooltip>
      </property>
      <property>
        <name>Alarm Status</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
        <tooltip>On shows members and admins in the app whether the alarm is armed, in alarm or has trouble; viewers never see it. Read only: DirectorLink never arms or disarms. Off: DirectorLink does not watch the alarm.</tooltip>
      </property>
      <property>
        <name>Remote Access</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
      </property>
      <property>
        <name>Remote Status</name>
        <default>Off</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Direct HTTPS</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>Allowed</item>
        </items>
        <default>Off</default>
        <tooltip>Test build. Allowed lets DirectorLink also serve its API over HTTPS on port 28443, under a name of its own (Direct HTTPS Status), so that iPhones and iPads reach it at home without the account. In this test build Allowed alone turns it on; from 1.12 the homeowner then turns it on in the app. Off: no HTTPS server and no key.</tooltip>
      </property>
      <property>
        <name>Direct HTTPS Status</name>
        <default>Off</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Schedules</name>
        <type>LIST</type>
        <items>
          <item>On</item>
          <item>Paused</item>
        </items>
        <default>On</default>
      </property>
      <property>
        <name>Schedule Status</name>
        <default>None</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Last Automation</name>
        <default></default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Jewish Calendar</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
      </property>
      <property>
        <name>Calendar Status</name>
        <default>Off</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Sonos</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
        <tooltip>On: DirectorLink finds the Sonos players on the home network and shows each Sonos room in the app, in the Control4 room of the same name; members play, pause, skip and set the volume. Off: DirectorLink does not look for or talk to any Sonos.</tooltip>
      </property>
      <property>
        <name>Sonos Address</name>
        <type>STRING</type>
        <default></default>
        <tooltip>Optional. One Sonos player's IP address, if DirectorLink does not find the players by itself: that player lists the others.</tooltip>
      </property>
      <property>
        <name>Sonos Players</name>
        <default>Off</default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items>
          <item>Debug</item>
          <item>Info</item>
          <item>Warning</item>
          <item>Error</item>
        </items>
        <default>Info</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Inventory</name>
        <default></default>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
    </properties>
  </config>

  <!-- A self-contained device (combo driver, its own proxy), as up to 0.2.0: DirectorLink has no
       child proxies. The first key comes from a pairing code created with New Pairing Code. -->
  <combo>true</combo>
  <proxies>
    <proxy>DirectorLink</proxy>
  </proxies>
</devicedata>
